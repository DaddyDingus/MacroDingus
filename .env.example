# Optional shared fallback for accounts that have not entered their own key
ANTHROPIC_API_KEY=

# MacroDaddy Tailscale sidecar (omit it if you use another proxy)
TS_AUTHKEY=

# Optional external weight relay; URL, account name, and key file must be set
WEIGHT_SYNC_RELAY_URL=
WEIGHT_SYNC_USER_NAME=
WEIGHT_SYNC_RELAY_KEY_FILE=
