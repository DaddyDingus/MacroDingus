# Copy to .env and fill in. NEVER commit the resulting .env — it is gitignored
# for a reason. Every value below is a placeholder; generate your own.

# ── Required ────────────────────────────────────────────────────────────────

# Session cookie signing key. Generate with: openssl rand -hex 32
# Rotating this invalidates every existing session, which is also the
# break-glass "log everyone out now" control.
MACRODINGUS_COOKIE_SECRET=replace-me-with-openssl-rand-hex-32

# ── Recommended ─────────────────────────────────────────────────────────────

# IANA timezone for calendar-day boundaries (check-ins, history windows).
# Get this wrong and every day boundary shifts by an hour for half the year.
APP_TIME_ZONE=Australia/Sydney

# Self-service account creation. Leave false. Set true only long enough to
# create your account, then set it back to false and redeploy. While false the
# signup endpoint returns 404 rather than 403, so it does not confirm it exists.
MACRODINGUS_ALLOW_SIGNUP=false

# Behind a reverse proxy this MUST be true, or the login rate limiter sees only
# the proxy's address and buckets every request together — one hostile client
# would lock out everyone. Set false only when running with no proxy at all.
MACRODINGUS_TRUST_PROXY=true

# ── Optional: OIDC single sign-on (Authentik, Keycloak, etc.) ───────────────
# Set all four to enable "Sign in with <provider>" on the login screen. Local
# password login remains available as break-glass for when the IdP is down.
# Leave blank for password-only.

MACRODINGUS_OIDC_ISSUER=
MACRODINGUS_OIDC_CLIENT_ID=
MACRODINGUS_OIDC_CLIENT_SECRET=
MACRODINGUS_OIDC_REDIRECT_URI=

# Optional authorisation gate — only members of this group may sign in.
MACRODINGUS_OIDC_REQUIRED_GROUP=

# Cosmetic: the name shown on the sign-in button.
MACRODINGUS_OIDC_PROVIDER_NAME=Authentik

# ── Deliberately omitted ────────────────────────────────────────────────────
#
# ANTHROPIC_API_KEY
#   An installation-wide fallback key that ANY account on the instance can
#   spend. Prefer the per-account key entered under More > AI features: it is
#   stored 0600 on the server, validated before saving, and never returned by
#   any API or sent to the browser.
#
# WEIGHT_SYNC_RELAY_URL / WEIGHT_SYNC_USER_NAME
#   When BOTH are set, every weight mutation POSTs your entire weight history
#   to that URL, best-effort, silently swallowing all failures. Left out
#   entirely rather than blank — an absent variable cannot be half-configured
#   by a typo.
