# Optional shared fallback for accounts that have not entered their own key
ANTHROPIC_API_KEY=

# Tailscale sidecar (omit the sidecar from compose if you use another proxy)
TS_AUTHKEY=
TS_HOSTNAME=macrotrack

# Optional external weight relay; both must be set to enable it
WEIGHT_SYNC_RELAY_URL=
WEIGHT_SYNC_USER_NAME=
